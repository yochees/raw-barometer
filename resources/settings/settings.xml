<!-- Phone app / Garmin Express settings (store installs only). The menu in
     RawBaroMenu.mc edits the same property on the watch. -->
<settings>
    <setting propertyKey="@Properties.Unit" title="@Strings.SettUnit">
        <settingConfig type="list">
            <listEntry value="0">@Strings.UnitHpa</listEntry>
            <listEntry value="1">@Strings.UnitMbar</listEntry>
            <listEntry value="2">@Strings.UnitInhg</listEntry>
            <listEntry value="3">@Strings.UnitMmhg</listEntry>
        </settingConfig>
    </setting>
</settings>
